generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

// The state machine for Family ID applications
enum ApplicationStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
}

enum EvaluationScope {
  HOUSEHOLD
  PARENTS_ONLY
  INDIVIDUAL
}

enum BenefitStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PANCARD
  RATION_CARD
  INCOME_PROOF
  RENT_AGREEMENT
  MARRIAGE_CERTIFICATE
  BIRTH_CERTIFICATE
  ADOPTION_DEED
  MARKSHEET
  CASTE_CERTIFICATE
  OTHER
}

// ============================================
// AUTH: Separation of Concerns
// ============================================

model UserAccount {
  account_id      String   @id @default(uuid()) @db.Uuid
  mobile_number   String   @unique
  hashed_password String?  // Optional if strictly using OTPs
  role            String   @default("citizen") // "citizen", "officer", "admin"
  created_at      DateTime @default(now())

  // Link the account to the actual citizen profile
  citizen_id      String   @unique @db.Uuid
  citizen         Citizen  @relation(fields: [citizen_id], references: [citizen_id])
}

// ============================================
// CORE DEMOGRAPHIC DATA
// ============================================

model Family {
  family_id              String            @id @default(uuid()) @db.Uuid
  family_id_number       String?           @unique  // Official 12-digit ID (NULL until ACTIVE)
  tracking_number        String            @unique  // Temporary ID (e.g., TEMP-12345)
  ration_card_no         String?           @unique
  current_address        String?
  district               String?
  state                  String?
  household_total_income Decimal?          @db.Decimal(12, 2)
  status                 ApplicationStatus @default(DRAFT)
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  citizens               Citizen[]
  document_mappings      DocumentMapping[]
}

model Citizen {
  citizen_id             String       @id @default(uuid()) @db.Uuid
  aadhaar_id             String       @unique
  family_id              String       @db.Uuid
  head_id                String?      @db.Uuid
  full_name              String
  date_of_birth          DateTime?
  gender                 String?
  occupation             String?
  annual_income          Decimal?     @db.Decimal(12, 2)
  is_head_of_family      Boolean      @default(false)
  is_aadhaar_verified    Boolean      @default(false)
  relationship           String?       // spouse, child, parent, sibling, adopted_child, other
  relationship_custom    String?       // custom text if relationship = 'other'
  caste                  String?       // General, OBC, SC, ST
  created_at             DateTime     @default(now())

  // Relations
  family                 Family       @relation(fields: [family_id], references: [family_id])
  head                   Citizen?     @relation("CitizenHead", fields: [head_id], references: [citizen_id])
  members                Citizen[]    @relation("CitizenHead")

  // Auth (only the Head of Family who logs in has this)
  account                UserAccount?

  benefit_logs           BenefitLog[]
  document_mappings      DocumentMapping[]
}

// ============================================
// WELFARE SCHEMES
// ============================================

model Scheme {
  scheme_id              String          @id @default(uuid()) @db.Uuid
  scheme_name            String
  department             String?
  description            String?
  income_threshold       Decimal?        @db.Decimal(12, 2)
  evaluation_scope       EvaluationScope
  redirect_link          String?

  benefit_logs           BenefitLog[]
}

model BenefitLog {
  log_id                 String        @id @default(uuid()) @db.Uuid
  citizen_id             String        @db.Uuid
  scheme_id              String        @db.Uuid
  status                 BenefitStatus @default(PENDING)
  date_evaluated         DateTime      @default(now())

  // Relations
  citizen                Citizen       @relation(fields: [citizen_id], references: [citizen_id])
  scheme                 Scheme        @relation(fields: [scheme_id], references: [scheme_id])
}

// ============================================
// DOCUMENT MANAGEMENT
// ============================================

model Document {
  document_id   String       @id @default(uuid()) @db.Uuid
  document_url  String       // S3 URL or local file path
  document_type DocumentType
  file_name     String?
  uploaded_at   DateTime     @default(now())

  mappings      DocumentMapping[]
}

model DocumentMapping {
  mapping_id    String    @id @default(uuid()) @db.Uuid
  document_id   String    @db.Uuid

  // Optional foreign keys to map document to a specific Citizen or Family
  citizen_id    String?   @db.Uuid
  family_id     String?   @db.Uuid

  // Verification fields (set by officer)
  is_verified   Boolean   @default(false)
  verified_by   String?   // officer account_id
  verified_at   DateTime?
  reject_reason String?   // reason if document is rejected

  document      Document  @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  citizen       Citizen?  @relation(fields: [citizen_id], references: [citizen_id], onDelete: Cascade)
  family        Family?   @relation(fields: [family_id], references: [family_id], onDelete: Cascade)

  @@index([citizen_id])
  @@index([family_id])
}
